# The app works in server-memory demo mode without these values.
# Public project API URL, for example https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Browser-safe publishable key (sb_publishable_...). Preferred: Supabase
# plans to deprecate the legacy anon JWT by the end of 2026.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Legacy anon JWT. Still accepted, and still used when the publishable key
# above is unset, so an in-flight migration can be rolled back without a code
# change. Both may be set at once during a migration: readSupabasePublicKey()
# in lib/supabase/public-env.ts takes the publishable key when it is present
# and non-empty, and only falls back to this one otherwise.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical public app origin used only when OAuth URL code runs without a
# browser window. In production, use your real domain—not https://vercel.app.
NEXT_PUBLIC_SITE_URL=https://www.stackchips.app

# Public Adsterra rewarded-unit key. Leave empty to render the reserved slot
# without loading a vendor unit until the dashboard key is available.
NEXT_PUBLIC_ADSTERRA_KEY=

# Public Cloudflare Turnstile site key for the sign-in/sign-up form's bot
# check. Free at dash.cloudflare.com -> Turnstile. Leave empty to render the
# form without the widget. The matching *secret* key is never entered here --
# paste it into the Supabase dashboard instead (Authentication -> Attack
# Protection -> Enable CAPTCHA protection), and only turn that toggle on
# after this site key is live in production, or real sign-ins will start
# failing for lack of a token.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-only secret/service-role key. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Master key exchanged only by POST /api/admin/session for a short-lived,
# signed HttpOnly admin cookie. Leave unset to disable admin access entirely.
# Generate with `openssl rand -hex 32` and never send it to ordinary routes.
ADMIN_SECRET=

# Authorizes GET /api/cron/rollover-season (see vercel.json). Vercel sends
# this automatically as `Authorization: Bearer <value>` for any project with
# CRON_SECRET set -- add it as a Vercel env var, nothing else to wire up.
# Leave unset to disable the route. Generate with `openssl rand -hex 32`.
CRON_SECRET=

# Signs the guest/player river_session cookie so a client-supplied value can
# round-trip a previously server-issued identity but never mint one.
# Optional and additive: leave unset and every session behaves exactly as it
# always has (a bare, unsigned UUID) -- unlike ADMIN_SECRET/CRON_SECRET, an
# unset SESSION_SECRET must never mean "no session," only "no signing" yet.
# Setting it later is safe to do at any time: existing unsigned cookies keep
# working during the transition (see session.ts's verifyToken), new ones get
# signed going forward. Generate with `openssl rand -hex 32`.
SESSION_SECRET=

# Stripe Checkout/Billing for voluntary support -- one-time and monthly, three
# tiers, grants no Gold and no gameplay effect (lib/legal/documents.ts's
# support_disclosure). Secret and webhook values are server-only; never
# prefix them with NEXT_PUBLIC_.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Each support tier is two independent live Stripe Price ids -- one-time and
# monthly recurring. A tier with neither configured simply doesn't appear;
# with only one configured, only that button renders.
STRIPE_PRICE_SUPPORT_SUPPORTER_ONCE=
STRIPE_PRICE_SUPPORT_SUPPORTER_MONTHLY=
STRIPE_PRICE_SUPPORT_BACKER_ONCE=
STRIPE_PRICE_SUPPORT_BACKER_MONTHLY=
STRIPE_PRICE_SUPPORT_PATRON_ONCE=
STRIPE_PRICE_SUPPORT_PATRON_MONTHLY=

# Test-mode Stripe. Both live and test webhook endpoints may point at the
# same /api/stripe/webhook route -- the handler tells them apart by which
# secret verifies the raw-body signature, never by anything the browser
# sends. Leave unset to disable test-mode purchases entirely.
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_WEBHOOK_SECRET=
STRIPE_TEST_PRICE_SUPPORT_SUPPORTER_ONCE=
STRIPE_TEST_PRICE_SUPPORT_SUPPORTER_MONTHLY=
STRIPE_TEST_PRICE_SUPPORT_BACKER_ONCE=
STRIPE_TEST_PRICE_SUPPORT_BACKER_MONTHLY=
STRIPE_TEST_PRICE_SUPPORT_PATRON_ONCE=
STRIPE_TEST_PRICE_SUPPORT_PATRON_MONTHLY=

# Comma-separated profile ids allowed to attempt a Stripe test-mode purchase.
# Server-only; a test purchase for any profile not listed here is rejected.
STRIPE_TEST_ALLOWED_PROFILE_IDS=
