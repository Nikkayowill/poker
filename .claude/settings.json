{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "G=\"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-shared-worktree.sh\"; [ -x \"$G\" ] && exec \"$G\" || exit 0",
            "if": "Bash(git *)",
            "timeout": 10,
            "statusMessage": "Checking the shared worktree"
          }
        ]
      }
    ]
  }
}
